import { App } from 'aws-cdk-lib';
import { Match, Template } from 'aws-cdk-lib/assertions';
import { describe, expect, it } from 'vitest';

import { ApplicationStack } from '../../lib/stacks/application-stack';

const PROJECT_NAME = '{{PROJECT_NAME}}';
const ENVIRONMENT_NAME = '{{DEFAULT_ENVIRONMENT}}';
const REGION = '{{REGION}}';

const synthesize = (environmentName: string = ENVIRONMENT_NAME): Template => {
  const app = new App();
  const stack = new ApplicationStack(app, `${PROJECT_NAME}-${environmentName}`, {
    env: { region: REGION },
    projectName: PROJECT_NAME,
    environmentName,
  });

  return Template.fromStack(stack);
};

describe('ApplicationStack', () => {
  // Guards the whole template against unintended change. Read the diff before updating it.
  it('matches the CloudFormation snapshot', () => {
    expect(synthesize().toJSON()).toMatchSnapshot();
  });

  it('creates a main queue and a dead-letter queue', () => {
    synthesize().resourceCountIs('AWS::SQS::Queue', 2);
  });

  it('enforces TLS on every queue', () => {
    synthesize().resourceCountIs('AWS::SQS::QueuePolicy', 2);
    synthesize().hasResourceProperties('AWS::SQS::QueuePolicy', {
      PolicyDocument: Match.objectLike({
        Statement: Match.arrayWith([
          Match.objectLike({
            Effect: 'Deny',
            Condition: { Bool: { 'aws:SecureTransport': 'false' } },
          }),
        ]),
      }),
    });
  });

  it('tags the main queue with the project and the environment it was built for', () => {
    synthesize('prod').hasResourceProperties('AWS::SQS::Queue', {
      Tags: Match.arrayWith([
        { Key: 'Environment', Value: 'prod' },
        { Key: 'Project', Value: PROJECT_NAME },
      ]),
    });
  });

  it('outputs the queue URL', () => {
    expect(Object.keys(synthesize().findOutputs('QueueUrl'))).toHaveLength(1);
  });
});
