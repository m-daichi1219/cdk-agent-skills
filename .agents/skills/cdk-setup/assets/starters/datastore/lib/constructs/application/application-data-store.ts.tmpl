import { RemovalPolicy } from 'aws-cdk-lib';
import { AttributeType, BillingMode, Table } from 'aws-cdk-lib/aws-dynamodb';
import { Construct } from 'constructs';

export interface ApplicationDataStoreProps {
  /**
   * What happens to the table when the stack is deleted.
   *
   * Defaults to `RETAIN`: losing production data must never be the default. Overriding this per
   * environment (for example `DESTROY` in a sandbox) is a project decision — make it explicitly.
   */
  readonly removalPolicy?: RemovalPolicy;
  /** Point-in-time recovery. Defaults to `true` (also required by cdk-nag AwsSolutions-DDB3). */
  readonly pointInTimeRecovery?: boolean;
  /** Blocks `DeleteTable` API calls. Defaults to `true`; turn it off for throw-away environments. */
  readonly deletionProtection?: boolean;
}

/**
 * Single-table data store for the application.
 *
 * This is the starter construct generated by `cdk-setup`: it shows the conventions (props with safe
 * defaults, one logical capability per construct, security-relevant properties made explicit) and
 * gives the pipeline something real to synthesize, test and check with cdk-nag. Adapt it to your
 * access patterns, or delete it together with its test once your own infrastructure exists.
 *
 * Uses the `Table` L2. Switch to `TableV2` when you need multi-region global tables.
 */
export class ApplicationDataStore extends Construct {
  public readonly table: Table;

  constructor(scope: Construct, id: string, props: ApplicationDataStoreProps = {}) {
    super(scope, id);

    this.table = new Table(this, 'Table', {
      // Generic single-table keys. Replace them with your real access pattern before deploying:
      // changing keys later replaces the table and destroys its data.
      partitionKey: { name: 'pk', type: AttributeType.STRING },
      sortKey: { name: 'sk', type: AttributeType.STRING },
      // On-demand costs nothing while idle and needs no capacity planning. Provisioned capacity
      // with autoscaling is cheaper at sustained high traffic — a workload decision, not a default.
      billingMode: BillingMode.PAY_PER_REQUEST,
      // Encryption at rest is on by default with the AWS-owned key (free, nothing to manage). A
      // customer-managed key adds rotation control, audit trail and cross-account grants at the
      // price of cost and key ownership — choose it deliberately, not by default.
      pointInTimeRecoverySpecification: {
        pointInTimeRecoveryEnabled: props.pointInTimeRecovery ?? true,
      },
      deletionProtection: props.deletionProtection ?? true,
      removalPolicy: props.removalPolicy ?? RemovalPolicy.RETAIN,
    });
  }
}
