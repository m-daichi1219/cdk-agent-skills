import { App, RemovalPolicy, Stack } from 'aws-cdk-lib';
import { Match, Template } from 'aws-cdk-lib/assertions';
import { describe, expect, it } from 'vitest';

import {
  ApplicationDataStore,
  type ApplicationDataStoreProps,
} from '../../lib/constructs/application/application-data-store';

const synthesize = (props?: ApplicationDataStoreProps): Template => {
  const app = new App();
  const stack = new Stack(app, 'TestStack', { env: { region: '{{REGION}}' } });

  new ApplicationDataStore(stack, 'DataStore', props);

  return Template.fromStack(stack);
};

describe('ApplicationDataStore', () => {
  it('matches the CloudFormation snapshot', () => {
    expect(synthesize().toJSON()).toMatchSnapshot();
  });

  // The props carry security-relevant defaults, so assert them instead of trusting the snapshot.
  it('defaults to a retained, protected, on-demand table with point-in-time recovery', () => {
    synthesize().hasResource('AWS::DynamoDB::Table', {
      DeletionPolicy: 'Retain',
      UpdateReplacePolicy: 'Retain',
      Properties: Match.objectLike({
        BillingMode: 'PAY_PER_REQUEST',
        DeletionProtectionEnabled: true,
        PointInTimeRecoverySpecification: { PointInTimeRecoveryEnabled: true },
        KeySchema: [
          { AttributeName: 'pk', KeyType: 'HASH' },
          { AttributeName: 'sk', KeyType: 'RANGE' },
        ],
      }),
    });
  });

  it('lets a caller opt out of every protection explicitly', () => {
    synthesize({
      removalPolicy: RemovalPolicy.DESTROY,
      pointInTimeRecovery: false,
      deletionProtection: false,
    }).hasResource('AWS::DynamoDB::Table', {
      DeletionPolicy: 'Delete',
      Properties: Match.objectLike({ DeletionProtectionEnabled: false }),
    });
  });
});
