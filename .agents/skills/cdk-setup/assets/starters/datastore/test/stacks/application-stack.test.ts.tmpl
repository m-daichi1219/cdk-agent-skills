import { App } from 'aws-cdk-lib';
import { Match, Template } from 'aws-cdk-lib/assertions';
import { describe, expect, it } from 'vitest';

import { ApplicationStack } from '../../lib/stacks/application-stack';

const PROJECT_NAME = '{{PROJECT_NAME}}';
const ENVIRONMENT_NAME = '{{DEFAULT_ENVIRONMENT}}';
const REGION = '{{REGION}}';

const synthesize = (environmentName: string = ENVIRONMENT_NAME): Template => {
  const app = new App();
  const stack = new ApplicationStack(app, `${PROJECT_NAME}-${environmentName}`, {
    env: { region: REGION },
    projectName: PROJECT_NAME,
    environmentName,
  });

  return Template.fromStack(stack);
};

describe('ApplicationStack', () => {
  // Guards the whole template against unintended change. Read the diff before updating it.
  it('matches the CloudFormation snapshot', () => {
    expect(synthesize().toJSON()).toMatchSnapshot();
  });

  it('creates exactly one DynamoDB table', () => {
    synthesize().resourceCountIs('AWS::DynamoDB::Table', 1);
  });

  it('keeps point-in-time recovery enabled', () => {
    synthesize().hasResourceProperties('AWS::DynamoDB::Table', {
      PointInTimeRecoverySpecification: { PointInTimeRecoveryEnabled: true },
    });
  });

  it('retains the table and blocks accidental deletion', () => {
    synthesize().hasResource('AWS::DynamoDB::Table', {
      DeletionPolicy: 'Retain',
      UpdateReplacePolicy: 'Retain',
      Properties: Match.objectLike({ DeletionProtectionEnabled: true }),
    });
  });

  it('tags resources with the project and the environment it was built for', () => {
    synthesize('prod').hasResourceProperties('AWS::DynamoDB::Table', {
      Tags: Match.arrayWith([
        { Key: 'Environment', Value: 'prod' },
        { Key: 'Project', Value: PROJECT_NAME },
      ]),
    });
  });

  it('outputs the table name', () => {
    expect(Object.keys(synthesize().findOutputs('DataStoreTableName'))).toHaveLength(1);
  });
});
